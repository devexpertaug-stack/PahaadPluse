{
  "name": "PahadPulse (free, non-provisioning)",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "PahadPulse dashboard (Next.js)",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "PahadPulse API (FastAPI)"
    }
  },
  "postCreateCommand": "make setup",
  "postAttachCommand": "echo 'Run: make demo  — then open the forwarded port 3000 (set visibility to Public for a live URL).'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
