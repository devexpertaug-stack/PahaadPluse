# =============================================================================
# PahadPulse — environment configuration (Req 32.2)
# Copy to `.env` and fill real values. NEVER commit real secrets.
# Every external service defaults to a local/mock/fallback implementation so the
# platform runs end-to-end with NO third-party credentials.
# =============================================================================

# ---- Core app ----
APP_ENV=local
# CORS origin for the Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000
# SQLAlchemy async URL. Defaults to a local SQLite file under backend/data/.
DATABASE_URL=sqlite+aiosqlite:///./data/pahadpulse.sqlite

# ---- Security / privacy (never commit real values) ----
# Key used to encrypt PII at rest. Generate a strong random value in real deployments.
PII_ENCRYPTION_KEY=dev-only-pii-key-change-me
# Salt used for deterministic pseudonymisation of guest identifiers.
PSEUDONYM_SALT=dev-only-pseudonym-salt-change-me
# Secret used to sign session / auth tokens.
SESSION_SECRET=dev-only-session-secret-change-me

# ---- Sentiment engine adapter ----
# Provider: "fallback" (deterministic lexicon/heuristic) or "muril" (real model).
SENTIMENT_MODEL_PROVIDER=fallback
SENTIMENT_MODEL_NAME=lexicon-fallback-v1
# Local path or HF id for the real model (only used when provider != fallback).
SENTIMENT_MODEL_PATH=

# ---- LLM adapter ----
# Provider: "fallback" (deterministic template) or "openai"/"azure"/etc.
LLM_API_PROVIDER=fallback
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_API_MODEL=template-fallback-v1

# ---- WhatsApp gateway adapter ----
# Provider: "mock" (in-process), "twilio", or "meta".
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=
# HMAC secret used to verify inbound webhook signatures (Req 20.4).
WHATSAPP_SIGNING_SECRET=dev-only-whatsapp-signing-secret

# ---- Voice / transcription adapter ----
# Provider: "stub" or "whisper".
VOICE_PROVIDER=stub
VOICE_MODEL_PATH=

# ---- Geocoder adapter ----
# Provider: "gazetteer" (local curated), optionally falling back to external.
GEOCODER_PROVIDER=gazetteer
GEOCODER_API_KEY=
GEOCODER_API_BASE_URL=
