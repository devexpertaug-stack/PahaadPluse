# =============================================================================
# PahadPulse frontend — environment configuration
# Copy to `.env.local` and adjust for your deployment. All values are optional
# for local use: `make demo` sets NEXT_PUBLIC_API_BASE_URL automatically.
# =============================================================================

# Base URL of the FastAPI backend the browser should call.
# Local default (used when unset): http://127.0.0.1:8000
# For a live/public deploy, set this to your deployed backend's public URL,
# e.g. https://pahadpulse-api.onrender.com — this is the ONE variable the
# presenter sets so the deployed frontend talks to the deployed backend.
# The matching backend variable is FRONTEND_ORIGIN (CORS) in the backend .env.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
